{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "movement-catalog.js",
    "react-app.js",
    "supabase-sync.js",
    "supabase-config.js",
    "playwright.config.js",
    "e2e/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
