# Local Playwright target. Omit this to let Playwright start the bundled server.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173

# Deterministic mode used by default and in pull-request CI.
E2E_MODE=mock
E2E_USER_EMAIL=e2e-athlete@example.test

# Optional real staging Supabase mode. Never use production credentials here.
# E2E_MODE=staging
# E2E_SUPABASE_URL=https://your-test-project.supabase.co
# E2E_SUPABASE_ANON_KEY=your-test-publishable-key
# E2E_SUPABASE_SERVICE_ROLE_KEY=your-test-secret-key
# E2E_USER_EMAIL=dedicated-e2e-user@example.com
# The app uses magic-link authentication, so E2E_USER_PASSWORD is not used.
# E2E_USER_PASSWORD=

# Remote cleanup is disabled unless all safety checks pass and this is true.
E2E_ENABLE_REMOTE_CLEANUP=false

# Only needed for a non-production URL whose hostname does not contain
# localhost, local, test, staging, preview, or dev.
# E2E_ALLOW_NON_PRODUCTION_SUPABASE=I_UNDERSTAND_THIS_IS_NOT_PRODUCTION
